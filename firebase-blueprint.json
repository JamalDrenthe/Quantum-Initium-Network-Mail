{
  "entities": {
    "User": {
      "title": "User",
      "description": "Network user profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "lastSeen": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "handle"]
    },
    "Email": {
      "title": "Email",
      "description": "Business email for the Quantum Initium Network",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "subject": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "recipientScope": { "type": "string" },
        "priority": { "type": "string" },
        "starred": { "type": "boolean" },
        "readBy": { "type": "array" },
        "attachment": { "type": "string" },
        "body": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["companyId", "subject", "senderName", "senderEmail", "body", "timestamp"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Instant messaging communication between network partners and companies",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "companyId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "text": { "type": "string" },
        "linkedEmailSubject": { "type": "string" },
        "linkedEmailCompany": { "type": "string" },
        "timestamp": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["channelId", "companyId", "senderId", "senderName", "text", "timestamp"]
    },
    "PinnedTopic": {
      "title": "PinnedTopic",
      "description": "Pinned email topic for QI Chat channels",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "emailId": { "type": "string" },
        "emailSubject": { "type": "string" },
        "companyId": { "type": "string" },
        "summary": { "type": "string" },
        "pinnedBy": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["channelId", "emailId", "emailSubject", "companyId", "summary", "pinnedBy", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profiles for registered network members"
    },
    "/emails/{emailId}": {
      "schema": "Email",
      "description": "Central emails across 12 business entities"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Real time communication channels"
    },
    "/pinned_topics/{topicId}": {
      "schema": "PinnedTopic",
      "description": "Pinned topics in communication channels"
    }
  }
}
