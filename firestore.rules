rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /emails/{emailId} {
      allow read, write: if true;
    }
    match /chats/{chatId} {
      allow read, write: if true;
    }
    match /pinned_topics/{topicId} {
      allow read, write: if true;
    }
    match /admins/{adminId} {
      allow read, write: if true;
    }
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if true;
    }
  }
}
